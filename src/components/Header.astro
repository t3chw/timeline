---
import { site } from '../config';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Timeline', current: path === '/' || path.startsWith('/notes') },
  { href: '/subjects', label: 'Subjects', current: path.startsWith('/subjects') },
];
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="9" fill="var(--accent)" />
        <path d="M11 8v16" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
        <circle cx="11" cy="10" r="3" fill="#fff" />
        <circle cx="11" cy="22" r="3" fill="#fff" />
        <path d="M18 10h6M18 22h6" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
      </svg>
      {site.title}
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle light and dark theme">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z" />
      </svg>
    </button>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
